{
  "manifest_version": 3,
  "name": "Consulta SLA Azure DevOps",
  "version": "1.0.0",
  "description": "Consulta o SLA do Work Item aberto no Azure DevOps.",
  "permissions": ["tabs", "storage", "webNavigation"],
  "host_permissions": [
    "https://dev.azure.com/*",
    "https://integracao-n8n.br.engineering/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "plugin_icon.png",
    "32": "plugin_icon.png",
    "48": "plugin_icon.png",
    "128": "plugin_icon.png"
  },
  "action": {
    "default_title": "Consulta SLA",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "plugin_icon.png",
      "32": "plugin_icon.png",
      "48": "plugin_icon.png",
      "128": "plugin_icon.png"
    }
  }
}
